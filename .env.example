# 🔧 Environment Variables for Stock Pattern Analyzer

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Next.js App URL (required for metadata generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL API KEYS (if Yahoo Finance API becomes restricted)
# =============================================================================

# Alpha Vantage API (alternative stock data provider)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_api_key_here

# Twelve Data API (another alternative provider)
# Get your free API key at: https://twelvedata.com/pricing
# TWELVE_DATA_API_KEY=your_api_key_here

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug logging in development
# NODE_ENV=development

# API rate limiting (requests per minute)
# API_RATE_LIMIT=60

# =============================================================================
# PRODUCTION SETTINGS (for deployment)
# =============================================================================

# Production URL (update this for your deployed app)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Database URL (if you plan to add user accounts/saved analysis)
# DATABASE_URL=your_database_connection_string

# Authentication secrets (if you add user authentication)
# NEXTAUTH_SECRET=your_random_secret_string
# NEXTAUTH_URL=https://your-domain.com

# =============================================================================
# ANALYTICS & MONITORING (optional)
# =============================================================================

# Google Analytics
# NEXT_PUBLIC_GA_ID=GA_MEASUREMENT_ID

# Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Content Security Policy (CSP) settings
# CSP_REPORT_URI=https://your-csp-report-endpoint.com

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Update NEXT_PUBLIC_APP_URL to your domain for production
#
# 3. Add any optional API keys as needed
#
# 4. Never commit .env.local to version control!

# =============================================================================
# IMPORTANT NOTES
# =============================================================================

# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Other variables are only available on the server-side
# - Always use HTTPS in production
# - Keep API keys secure and rotate them regularly
